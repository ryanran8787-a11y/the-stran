# ---------------------------------------------------------------
# 複製為 .env 後填入真實值。.env 已被 .gitignore 忽略，不會進版控。
# GitHub Actions 請改設定為 Repository Secrets（同名）。
# ---------------------------------------------------------------

# NVD API Key（免費申請：https://nvd.nist.gov/developers/request-an-api-key）
# 有 key：50 requests / 30 秒；無 key：5 requests / 30 秒
NVD_API_KEY=

# LLM Provider: gemini | openai | claude | none
LLM_PROVIDER=gemini

# --- Gemini ---
GEMINI_API_KEY=
# 留空 = 自動偵測可用模型（建議留空，避免模型改名導致失敗）
GEMINI_MODEL=

# --- OpenAI（可選）---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- Anthropic（可選）---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- GitHub（可選，用於提高 GitHub Advisory API 速率上限 60/hr -> 5000/hr）---
GITHUB_TOKEN=

# ---------------------------------------------------------------
# 管線行為參數（通常不需要改）
# ---------------------------------------------------------------
# 只保留：CVSS >= 此分數、或在野利用、或 EPSS >= 門檻
FILTER_MIN_CVSS=9.0
FILTER_MIN_EPSS=0.5

# KEV 在野清單往前回看天數（避免跨時區漏抓）
KEV_LOOKBACK_DAYS=3

# 單次 LLM 呼叫最多處理幾筆（批次）
LLM_BATCH_SIZE=18

# LLM 最多處理幾筆（成本護欄）
LLM_MAX_ITEMS=80

# 資料輸出目錄
DATA_DIR=data
